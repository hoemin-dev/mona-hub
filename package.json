  "scripts": {
    "test:webview": "npm --prefix tools/webview-test run tauri:dev",
    "web:dev": "node scripts/dev-server.cjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:access": "tauri dev --config src-tauri/tauri.access-dev.conf.json",
