    "check": "node --check web/login/login.js && node --check web/app/app.js && node --check web/appbar-shell.js && node --check web/profile-popup/popup.js && node --check web/auth/auth-controller.js && node --check web/auth/access-auth-provider.js && node --check web/config/auth.js && node --check web/app/config/environment.js && node --check web/auth/mona-session.js",
    "test": "node --test test/*.test.mjs",
    "check:loading": "node --check web/auth/session-loading.js && node --check web/prelogin/prelogin.js"
