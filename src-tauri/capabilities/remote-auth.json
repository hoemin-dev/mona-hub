{
  "$schema": "../gen/schemas/remote-schema.json",
  "identifier": "remote-auth",
  "description": "Restricts AppBar IPC access to MonaHub's authenticated web origins.",
  "windows": ["main", "profile-popup"],
  "remote": {
    "urls": [
      "https://mona-hub.pages.dev/*",
      "https://mona-hub.pages.dev/*",
      "https://mona-hub.pages.dev*"
    ]
  },
  "permissions": [
    "core:default"
  ]
}
