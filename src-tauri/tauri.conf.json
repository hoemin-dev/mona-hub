{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MONA-HUB",
  "version": "0.1.2",
  "identifier": "kr.co.monas.monahub",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:1420/",
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "prelogin/index.html",
        "useHttpsScheme": true,
        "title": "MONA-HUB",
        "width": 36,
        "height": 720,
        "minWidth": 36,
        "minHeight": 400,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": false,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "MONAS Pump Co., Ltd.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
